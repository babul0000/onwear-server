datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  customer
  reseller
  staff
  manager
  admin
}

enum ResellerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum PricingTier {
  TIER1
  TIER2
  CUSTOM
}

enum OrderType {
  RETAIL
  WHOLESALE
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

enum AccountStatus {
  ACTIVE
  PENDING_ACTIVATION
  SUSPENDED
}

enum CreatedFrom {
  DIRECT_REGISTRATION
  GUEST_CHECKOUT
  ADMIN_CREATED
}

model User {
  id              String           @id @default(uuid())
  name            String
  email           String           @unique
  password        String?
  phone           String?
  address         String?
  role            Role             @default(customer)
  accountStatus   AccountStatus    @default(ACTIVE)
  createdFrom     CreatedFrom      @default(DIRECT_REGISTRATION)
  emailVerified   Boolean          @default(false)
  isDeleted       Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  reviews         Review[]
  cart            Cart?
  wishlist        Wishlist?
  orders          Order[]
  addresses       Address[]
  resellerProfile ResellerProfile?
  activationTokens ActivationToken[]

  @@map("users")
  @@index([email])
}

model ActivationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("activation_tokens")
  @@index([userId])
  @@index([tokenHash])
}

model Category {
  id          String         @id @default(uuid())
  name        String
  slug        String         @unique
  description String?
  image       String?
  status      CategoryStatus @default(ACTIVE)
  isDeleted   Boolean        @default(false)
  
  parentId    String?
  parent      Category?      @relation("CategoryToSubcategory", fields: [parentId], references: [id], onDelete: Cascade)
  subcategories Category[]   @relation("CategoryToSubcategory")

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  products    Product[]

  @@map("categories")
  @@index([slug])
  @@index([parentId])
}

model Product {
  id            String          @id @default(uuid())
  name          String
  slug          String          @unique
  description   String?
  price         Float
  discountPrice Float?
  stock         Int             @default(0)
  sku           String          @unique
  image         String?
  image2        String?
  images        String[]        @default([])
  status        ProductStatus   @default(ACTIVE)
  categoryId    String
  category      Category        @relation(fields: [categoryId], references: [id])
  isDeleted     Boolean         @default(false)
  isResellerOnly Boolean        @default(false)
  sizeChartUrl   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  reviews       Review[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]

  @@map("products")
  @@index([slug])
  @@index([categoryId])
  @@index([status])
  @@index([createdAt])
}

model Review {
  id        String   @id @default(uuid())
  rating    Int
  comment   String?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@map("reviews")
  @@index([productId])
  @@index([userId])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(1)
  size      String?
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cart_items")
  @@index([cartId])
  @@index([productId])
}

model Wishlist {
  id        String         @id @default(uuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id])
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  items     WishlistItem[]

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([wishlistId, productId])
  @@map("wishlist_items")
  @@index([wishlistId])
}

model Order {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  totalAmount     Float
  shippingAddress String
  phone           String
  email           String?
  note            String?
  shippingCost    Float         @default(0)
  paymentMethod   String        @default("COD") // COD, BKASH, NAGAD, ONLINE
  paymentPhone    String?
  trxId           String?
  cancelReason    String?
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID)
  isDeleted       Boolean       @default(false)
  orderType      OrderType     @default(RETAIL)
  pricingTier    PricingTier?
  couponCode     String?
  discountApplied Float        @default(0)
  cancellable    Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  items           OrderItem[]
  transactions   Transaction[]
  codReconciliations CodReconciliation[]

  @@map("orders")
  @@index([userId])
  @@index([status])
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  productName String
  price       Float
  quantity    Int
  subtotal    Float
  size        String?
  color       String?
  createdAt   DateTime @default(now())

  @@map("order_items")
  @@index([orderId])
}

// Reseller profile model
model ResellerProfile {
  id              String         @id @default(uuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id])
  businessName    String
  nidOrTradeLicense String?
  status          ResellerStatus @default(PENDING)
  tier            PricingTier    @default(TIER1)
  creditLimit     Float          @default(0)
  outstandingCredit Float        @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("reseller_profiles")
}

// Coupons schema
model Coupon {
  id              String        @id @default(uuid())
  code            String        @unique
  discountType    DiscountType
  discountValue   Float
  minPurchase     Float         @default(0)
  firstOrderOnly  Boolean       @default(false)
  isActive        Boolean       @default(true)
  expiryDate      DateTime?
  
  totalLimit      Int           @default(100)
  usedCount       Int           @default(0)
  userLimit       Int           @default(1)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("coupons")
  @@index([code])
}

// Promotions & Slide banners
model Promotion {
  id          String    @id @default(uuid())
  title       String
  imageUrl    String
  linkUrl     String?
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("promotions")
}

// Flash Sales / Campaigns
model Campaign {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("campaigns")
  @@index([slug])
}

// Payment Gateway Transactions
model Transaction {
  id            String        @id @default(uuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id])
  gateway       String        // bKash, Nagad, SSLCommerz
  amount        Float
  status        String        // SUCCESS, FAILED, PENDING
  trxId         String        @unique
  callbackPayload String?     @db.Text
  createdAt     DateTime      @default(now())

  @@map("transactions")
  @@index([orderId])
  @@index([trxId])
}

// COD Reconciliation Ledger
model CodReconciliation {
  id            String        @id @default(uuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id])
  courierName   String        // Pathao, RedX, Steadfast
  expectedAmount Float
  receivedAmount Float        @default(0)
  isReconciled  Boolean       @default(false)
  discrepancyFlag Boolean     @default(false)
  reconciledAt  DateTime?
  createdAt     DateTime      @default(now())

  @@map("cod_reconciliations")
  @@index([orderId])
}

// Store settings model
model StoreSetting {
  id                  String   @id @default("default")
  storeName           String   @default("ONWEAR")
  tagline             String   @default("Unique way of elegance.")
  logoUrl             String?
  phone               String   @default("01603-742663")
  email               String   @default("onwear.25@gmail.com")
  address             String   @default("Khilkhet, Dhaka, Bangladesh, 1229")
  facebookUrl         String   @default("https://facebook.com/onwear.bd")
  instagramUrl        String   @default("https://instagram.com/onwear_bd")
  bkashNumber         String   @default("01603742663")
  nagadNumber         String   @default("01603742663")
  whatsappNumber      String   @default("8801883012641")
  shippingInsideDhaka Float    @default(80)
  shippingOutsideDhaka Float    @default(150)
  updatedAt           DateTime @updatedAt

  @@map("store_settings")
}

enum ShippingZone {
  INSIDE_DHAKA
  OUTSIDE_DHAKA
}

model Address {
  id         String       @id @default(uuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String       // "Home", "Office", etc.
  name       String
  phone      String
  line       String
  zone       ShippingZone @default(INSIDE_DHAKA)
  isDefault  Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@map("addresses")
  @@index([userId])
}


